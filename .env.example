# Copy to .env (gitignored) or set these in your user environment.
DEEPSEEK_API_KEY=replace-with-your-api-key
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash      (default; deepseek-v4-pro for the heavier model)
# DEEPSEEK_THINKING=auto             (global pin: auto | none | low | medium | high | max;
#                                     the find() tool's thinking arg overrides per call)
# DEEPSEEK_CHECK_MODEL=deepseek-v4-pro  (model for sanity_check verdicts)
