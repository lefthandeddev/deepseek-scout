# Select one provider. Default preserves the legacy DeepSeek behavior.
SCOUT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace-with-your-key
# SCOUT_MODEL=your-model-id
# SCOUT_CHECK_MODEL=your-checker-model-id
# SCOUT_API_KEY=replace-with-your-key
# SCOUT_BASE_URL=https://your-endpoint.example/v1
# SCOUT_THINKING=auto
# SCOUT_REASONING_MODE=off
# SCOUT_TOOL_CHOICE=named
# SCOUT_TIMEOUT_SECONDS=120
# SCOUT_MAX_OUTPUT_TOKENS=0
# SCOUT_LOCAL_ONLY=1
# SCOUT_ALLOW_NO_KEY=1
# SCOUT_ALLOW_INSECURE_HTTP=1

# Offline/local example (replace the settings above rather than adding duplicates):
# SCOUT_PROVIDER=ollama
# SCOUT_MODEL=qwen3:8b
# SCOUT_LOCAL_ONLY=1
